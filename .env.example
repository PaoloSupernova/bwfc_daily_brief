# ============================================================
# BWFC Daily Brief - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_DEBUG=false
APP_TIMEZONE=Europe/London

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bwfc_daily_brief
DB_USER=root
DB_PASS=

# ── Anthropic / Claude API ────────────────────────────────────
# Get your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024
# Total request timeout in seconds (increase on slow connections)
ANTHROPIC_TIMEOUT=120
# TCP connection timeout in seconds (increase on corporate networks/VPNs)
ANTHROPIC_CONNECT_TIMEOUT=30

# ── Article fetcher ───────────────────────────────────────────
FETCH_TIMEOUT=15
FETCH_USER_AGENT=Mozilla/5.0 (compatible; BWFCDailyBrief/1.0)

# ── Authentication ────────────────────────────────────────────
# Set to true only when M365 SSO is configured.
# Leave false for local XAMPP use.
AUTH_ENABLED=false

# Full public URL of the app (no trailing slash). Used for OAuth2 redirect URI.
# Must match exactly what is registered in Azure Portal → App Registration → Redirect URIs.
# Example: https://brief.bwfc.co.uk
APP_URL=https://your-domain.com

# Azure AD / Microsoft Entra ID — from your App Registration in Azure Portal.
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-value
# Your organisation's tenant ID (found in Azure Portal → Azure Active Directory → Overview).
# Use 'common' to allow any Microsoft account (not recommended for production).
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional allowlist: comma-separated list of email addresses that may log in.
# If blank, any user in your Azure AD tenant can log in.
# Recommended: list only the comms team members.
AZURE_ALLOWED_EMAILS=person1@bwfc.co.uk,person2@bwfc.co.uk
