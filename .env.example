# Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/bwfc-daily-brief/public
APP_TIMEZONE=Europe/London

# Database (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bwfc_daily_brief
DB_USER=root
DB_PASS=

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# Auth (stubbed for local, activated on deployment)
AUTH_ENABLED=false
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Article fetching
FETCH_USER_AGENT="BWFC Daily Brief Tool/1.0"
FETCH_TIMEOUT=10
